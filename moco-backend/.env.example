# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Postgres -----------------------------------------------------------
# Point these at the DigitalOcean managed database when you split it out;
# nothing else in the code needs to change.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=moco
PGPASSWORD=moco
PGDATABASE=moco
PGSSL=false
PG_POOL_MAX=10

# --- Redis --------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0

# --- Auth ---------------------------------------------------------------
# REQUIRED in production; the process refuses to boot without it.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=30d
# Fixed OTP for local/QA builds. Ignored when NODE_ENV=production.
OTP_FIXED_CODE=123456
OTP_TTL=300
OTP_MAX_ATTEMPTS=5

# --- Agora --------------------------------------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600
AGORA_WEBHOOK_SECRET=
# Needed only for server-side channel termination on a forced end.
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=

# --- SMS (OTP delivery) -------------------------------------------------
# 'log' prints the OTP instead of sending it. Use 'msg91' in production.
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=MOCOAP

# --- Push ---------------------------------------------------------------
FCM_SERVER_KEY=

# --- Payments -----------------------------------------------------------
# 'mock' credits instantly in development. Use 'razorpay' for the web build;
# Play Store builds verify Google Play Billing purchases instead.
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Admin --------------------------------------------------------------
# Comma-separated phone numbers allowed to reach /api/admin/*.
ADMIN_PHONES=

# Clients older than this are asked to update.
MIN_APP_VERSION=1.0.0
