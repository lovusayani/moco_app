# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Postgres -----------------------------------------------------------
# Two ways to point at a database; DATABASE_URL wins when set.
#
# Option A — DATABASE_URL (used for Supabase-hosted Postgres in dev).
# Use Supabase's SESSION pooler connection string (Project Settings ->
# Database -> Connection string -> "Session pooler"), NOT the transaction
# pooler — this backend holds one BEGIN..COMMIT open per transaction on a
# single checked-out client (see withTransaction in src/config/db.js), which
# the transaction pooler does not reliably support. A direct connection
# string also works if your network has IPv6/direct access to it.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# PGSSL must be true whenever DATABASE_URL points at Supabase.
PGSSL=false
PG_POOL_MAX=10
#
# Option B — discrete fields (local Postgres via docker compose). Ignored
# once DATABASE_URL is set.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=moco
PGPASSWORD=moco
PGDATABASE=moco

# --- Redis --------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0

# --- Auth ---------------------------------------------------------------
# REQUIRED in production; the process refuses to boot without it.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=30d
# Fixed OTP for local/QA builds. Ignored when NODE_ENV=production.
OTP_FIXED_CODE=123456
OTP_TTL=300
OTP_MAX_ATTEMPTS=5

# --- Agora --------------------------------------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600
AGORA_WEBHOOK_SECRET=
# Needed only for server-side channel termination on a forced end.
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=

# --- SMS (OTP delivery) -------------------------------------------------
# 'log' prints the OTP instead of sending it. Use 'msg91' in production.
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=MOCOAP

# --- Push ---------------------------------------------------------------
FCM_SERVER_KEY=

# --- Payments -----------------------------------------------------------
# 'mock' credits instantly in development. Use 'razorpay' for the web build;
# Play Store builds verify Google Play Billing purchases instead.
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Supabase Storage (chat photo messages) ------------------------------
# Storage only — separate concern from DATABASE_URL above (which may or may
# not point at the same Supabase project). Service-role key is backend-only
# and never reaches Flutter. Both unset is a valid state: photo messages
# report themselves unavailable rather than the server failing to boot.
# Create a private "chat-media" bucket in the Supabase dashboard first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin --------------------------------------------------------------
# Comma-separated phone numbers allowed to reach /api/admin/*.
ADMIN_PHONES=

# Clients older than this are asked to update.
MIN_APP_VERSION=1.0.0

# --- Browser origins (CORS + WebSocket) ------------------------------------
# Comma-separated origins allowed to call the API from a browser. Production:
#   https://lovcamx.online,https://www.lovcamx.online,https://admin.lovcamx.online
# Outside production any http(s)://localhost:<port> is also allowed.
CORS_ORIGINS=

# --- Background jobs ---------------------------------------------------------
# vercel (Vercel Queues; automatic on Vercel) | inline (run in this process
# after the delay; the local default) | record (tests: publish nothing).
# JOBS_MODE=inline

# Vercel Cron authenticates to /api/cron/* with this bearer token (Vercel sets
# the header automatically when CRON_SECRET is defined in the project).
CRON_SECRET=

# --- Sign-in codes (src/modules/auth/otp.channels.js) ----------------------
# Email is the default method. 'log' prints the code (development only; it is
# refused in production). Production: 'resend' with a verified sender domain.
EMAIL_PROVIDER=log
EMAIL_FROM=
RESEND_API_KEY=
# OTP_RESEND_COOLDOWN=30
# OTP_MAX_SENDS_PER_HOUR=5
# Admin console access by verified email (comma-separated), alongside ADMIN_PHONES.
ADMIN_EMAILS=
# Optional channels — offered only when configured:
# WhatsApp Cloud API with an approved Authentication template
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# Telegram Gateway API (gateway.telegram.org)
TELEGRAM_GATEWAY_TOKEN=

# --- Moco Live (Stripcash aggregator API) ---------------------------------
# Leave empty to keep Live disabled.
# STRIPCASH_API_KEY: the domain API key — SECRET, backend only.
# STRIPCASH_USER_ID: the affiliate userId — a tracking id; the app's player
# gets it through GET /api/live/config.
STRIPCASH_API_KEY=
STRIPCASH_USER_ID=
# STRIPCASH_PLAYER_SCRIPT_URL: the official StripchatPlayer script URL from the
# affiliate dashboard (Player docs). Not secret; unset = in-app player unavailable.
STRIPCASH_PLAYER_SCRIPT_URL=
