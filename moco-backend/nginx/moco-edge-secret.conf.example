# Template for /etc/nginx/moco-edge-secret.conf — the real file is NOT in git.
#
# Replace CHANGE_ME with the same value as MOCO_EDGE_PROXY_SECRET in BOTH
# Vercel projects (moco-web and moco-admin). Generate one with:
#   openssl rand -hex 32
#
# Then: sudo chmod 600 /etc/nginx/moco-edge-secret.conf && sudo nginx -t && sudo systemctl reload nginx
#
# To rotate: add the new value as a second line first, update both Vercel
# projects and redeploy them, then remove the old line.

map $http_x_moco_edge_secret $moco_via_edge {
    default     0;
    "CHANGE_ME" 1;
}
